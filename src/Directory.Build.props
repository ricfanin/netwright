<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1707: MCP tool parameters use snake_case. CA1031: automation code must survive arbitrary provider failures. -->
    <NoWarn>$(NoWarn);CA1707;CA1031;CA1848;CA2254</NoWarn>
    <Version>2.0.0</Version>
    <Authors>Riccardo</Authors>
    <Copyright>Copyright (c) Riccardo</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ricfanin/netwright</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ricfanin/netwright</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mcp;wpf;winforms;winui;maui;ui-automation;e2e-testing;desktop;dotnet;ai-agents;playwright</PackageTags>
  </PropertyGroup>
</Project>
