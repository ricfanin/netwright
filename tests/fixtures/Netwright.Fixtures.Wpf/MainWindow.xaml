<Window x:Class="Netwright.Fixtures.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Netwright.Fixtures.Wpf"
        Title="Netwright Fixture (WPF)"
        Width="1000"
        Height="750"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,3" />
        </Style>
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldCaption" TargetType="TextBlock">
            <Setter Property="Margin" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top bar -->
        <Menu x:Name="menuMain" AutomationProperties.AutomationId="menuMain" DockPanel.Dock="Top">
            <MenuItem x:Name="miFile" AutomationProperties.AutomationId="miFile" Header="File">
                <MenuItem x:Name="miOpenModal" AutomationProperties.AutomationId="miOpenModal" Header="Open modal..." Click="OpenModal_Click" />
                <MenuItem x:Name="miExit" AutomationProperties.AutomationId="miExit" Header="Exit" Click="Exit_Click" />
            </MenuItem>
        </Menu>

        <WrapPanel DockPanel.Dock="Top" Margin="4">
            <Button x:Name="btnOpenModal" AutomationProperties.AutomationId="btnOpenModal" Content="Open modal" Click="OpenModal_Click" />
            <TextBlock x:Name="lblModalResult" AutomationProperties.AutomationId="lblModalResult" Style="{StaticResource ValueLabel}" Text="Modal result: none" />
            <Button x:Name="btnOpenWindow" AutomationProperties.AutomationId="btnOpenWindow" Content="Open tool window" Click="BtnOpenWindow_Click" />
            <Button x:Name="btnTrace" AutomationProperties.AutomationId="btnTrace" Content="Write diagnostics" Click="BtnTrace_Click" />
            <TextBlock x:Name="lblDiag" AutomationProperties.AutomationId="lblDiag" Style="{StaticResource ValueLabel}" Text="" />
            <Button x:Name="btnCrash" AutomationProperties.AutomationId="btnCrash" Content="Crash" Click="BtnCrash_Click" />
        </WrapPanel>

        <TabControl x:Name="tabs" AutomationProperties.AutomationId="tabs" Margin="4">

            <!-- Form -->
            <TabItem x:Name="tabForm" AutomationProperties.AutomationId="tabForm" Header="Form">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldCaption}" Text="Name:" />
                    <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Margin="4"
                             AutomationProperties.AutomationId="txtName" AutomationProperties.Name="Name" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldCaption}" Text="Email:" />
                    <TextBox x:Name="txtEmail" Grid.Row="1" Grid.Column="1" Margin="4"
                             AutomationProperties.AutomationId="txtEmail" AutomationProperties.Name="Email" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldCaption}" Text="Country:" />
                    <ComboBox x:Name="cmbCountry" Grid.Row="2" Grid.Column="1" Margin="4" IsEditable="False"
                              AutomationProperties.AutomationId="cmbCountry" AutomationProperties.Name="Country" />

                    <CheckBox x:Name="chkTerms" Grid.Row="3" Grid.Column="1" Margin="4"
                              AutomationProperties.AutomationId="chkTerms" Content="Accept terms"
                              Checked="ChkTerms_Changed" Unchecked="ChkTerms_Changed" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldCaption}" Text="Plan:" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="4">
                        <RadioButton x:Name="rbPlanFree" AutomationProperties.AutomationId="rbPlanFree" GroupName="Plan"
                                     Content="Free" IsChecked="True" Margin="0,0,16,0" />
                        <RadioButton x:Name="rbPlanPro" AutomationProperties.AutomationId="rbPlanPro" GroupName="Plan"
                                     Content="Pro" />
                    </StackPanel>

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldCaption}" Text="Quantity:" />
                    <Slider x:Name="sldQuantity" Grid.Row="5" Grid.Column="1" Margin="4"
                            AutomationProperties.AutomationId="sldQuantity" AutomationProperties.Name="Quantity"
                            Minimum="0" Maximum="10" Value="1"
                            SmallChange="1" LargeChange="1" TickFrequency="1"
                            IsSnapToTickEnabled="True" TickPlacement="BottomRight" />

                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btnSubmit" AutomationProperties.AutomationId="btnSubmit" Content="Submit"
                                IsEnabled="False" Click="BtnSubmit_Click" />
                        <Button x:Name="btnReset" AutomationProperties.AutomationId="btnReset" Content="Reset"
                                Click="BtnReset_Click" />
                    </StackPanel>

                    <TextBlock x:Name="lblResult" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                               AutomationProperties.AutomationId="lblResult"
                               Style="{StaticResource ValueLabel}" Text="" />
                </Grid>
            </TabItem>

            <!-- Async -->
            <TabItem x:Name="tabAsync" AutomationProperties.AutomationId="tabAsync" Header="Async">
                <StackPanel Margin="8" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnLoad" AutomationProperties.AutomationId="btnLoad" Content="Load data" Click="BtnLoad_Click" />
                        <TextBlock x:Name="lblStatus" AutomationProperties.AutomationId="lblStatus" Style="{StaticResource ValueLabel}" Text="Idle" />
                    </StackPanel>
                    <ListBox x:Name="lstItems" AutomationProperties.AutomationId="lstItems" AutomationProperties.Name="Items"
                             Width="300" Height="120" Margin="4" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnEnableLater" AutomationProperties.AutomationId="btnEnableLater" Content="Enable later" Click="BtnEnableLater_Click" />
                        <Button x:Name="btnLater" AutomationProperties.AutomationId="btnLater" Content="Later" IsEnabled="False" Click="BtnLater_Click" />
                        <TextBlock x:Name="lblLater" AutomationProperties.AutomationId="lblLater" Style="{StaticResource ValueLabel}" Text="" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- Grid -->
            <TabItem x:Name="tabGrid" AutomationProperties.AutomationId="tabGrid" Header="Grid">
                <DataGrid x:Name="gridOrders" Margin="8"
                          AutomationProperties.AutomationId="gridOrders" AutomationProperties.Name="Orders"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id, Mode=OneWay}" />
                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer, Mode=OneWay}" />
                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Mode=OneWay}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tree -->
            <TabItem x:Name="tabTree" AutomationProperties.AutomationId="tabTree" Header="Tree">
                <StackPanel Margin="8" HorizontalAlignment="Left">
                    <TreeView x:Name="treeFolders" AutomationProperties.AutomationId="treeFolders" AutomationProperties.Name="Folders"
                              Width="300" Height="240" Margin="4" HorizontalAlignment="Left"
                              SelectedItemChanged="TreeFolders_SelectedItemChanged">
                        <TreeViewItem Header="Root">
                            <TreeViewItem Header="Documents">
                                <TreeViewItem Header="Invoices" />
                                <TreeViewItem Header="Reports" />
                            </TreeViewItem>
                            <TreeViewItem Header="Pictures" />
                        </TreeViewItem>
                    </TreeView>
                    <TextBlock x:Name="lblSelectedNode" AutomationProperties.AutomationId="lblSelectedNode" Style="{StaticResource ValueLabel}" Text="" />
                    <Expander x:Name="expAdvanced" AutomationProperties.AutomationId="expAdvanced" Header="Advanced"
                              IsExpanded="False" Margin="4">
                        <CheckBox x:Name="chkVerbose" AutomationProperties.AutomationId="chkVerbose" Content="Verbose logging" Margin="16,4,4,4" />
                    </Expander>
                </StackPanel>
            </TabItem>

            <!-- Keyboard -->
            <TabItem x:Name="tabKeyboard" AutomationProperties.AutomationId="tabKeyboard" Header="Keyboard">
                <StackPanel Margin="8" HorizontalAlignment="Left">
                    <TextBox x:Name="txtKeys" AutomationProperties.AutomationId="txtKeys" AutomationProperties.Name="Keys"
                             Width="300" Margin="4" HorizontalAlignment="Left" />
                    <TextBlock x:Name="lblLastKey" AutomationProperties.AutomationId="lblLastKey" Style="{StaticResource ValueLabel}" Text="Last key: none" />
                    <local:MouseTarget x:Name="pnlMouse" AutomationProperties.AutomationId="pnlMouse" AutomationProperties.Name="Mouse target"
                                       Width="200" Height="100" Margin="4" HorizontalAlignment="Left"
                                       Background="SteelBlue" BorderBrush="DarkSlateBlue" BorderThickness="1"
                                       MouseLeftButtonDown="PnlMouse_MouseLeftButtonDown"
                                       MouseRightButtonDown="PnlMouse_MouseRightButtonDown" />
                    <TextBlock x:Name="lblMouse" AutomationProperties.AutomationId="lblMouse" Style="{StaticResource ValueLabel}" Text="Mouse: none" />
                </StackPanel>
            </TabItem>

            <!-- Scroll -->
            <TabItem x:Name="tabScroll" AutomationProperties.AutomationId="tabScroll" Header="Scroll">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="scrLong" Grid.Row="0"
                                  AutomationProperties.AutomationId="scrLong" AutomationProperties.Name="Long list"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="pnlScrollItems" Width="300" HorizontalAlignment="Left" />
                    </ScrollViewer>
                    <TextBlock x:Name="lblScrollClicked" Grid.Row="1" AutomationProperties.AutomationId="lblScrollClicked"
                               Style="{StaticResource ValueLabel}" Text="" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
