<Window x:Class="Netwright.Fixtures.WinUI.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm">
    <StackPanel Margin="16" MinWidth="240">
        <TextBlock x:Name="lblConfirm"
                   AutomationProperties.AutomationId="lblConfirm"
                   Text="Are you sure?"
                   Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnYes"
                    AutomationProperties.AutomationId="btnYes"
                    Content="Yes"
                    MinWidth="75"
                    Margin="0,0,8,0"
                    Click="BtnYes_Click" />
            <Button x:Name="btnNo"
                    AutomationProperties.AutomationId="btnNo"
                    Content="No"
                    MinWidth="75"
                    Click="BtnNo_Click" />
        </StackPanel>
    </StackPanel>
</Window>
